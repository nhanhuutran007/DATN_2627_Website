<mxfile host="drawio" type="device"><diagram name="KT02 - Kiến trúc phân lớp backend" id="KT02 - Kiến trúc phân lớp backend"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;KT02 – Kiến trúc phân lớp của Backend (NestJS)&lt;/b&gt;" style="fontFamily=Times New Roman;fontSize=13;text;html=1;align=center;fontSize=16;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Lớp giao tiếp (Controller)&lt;/b&gt;&lt;br&gt;Định tuyến REST /api/v1 · DTO + ValidationPipe (class-validator) · Guard: JwtAuthGuard, OptionalJwtAuthGuard, RolesGuard, RateLimitGuard · ClassSerializerInterceptor (ẩn passwordHash, thông tin khóa; email/phone chỉ ở nhóm user:private)" style="fontFamily=Times New Roman;fontSize=13;rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="720" height="110" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Lớp nghiệp vụ (Service)&lt;/b&gt;&lt;br&gt;Quy tắc nghiệp vụ, ma trận chuyển trạng thái, kiểm tra quyền sở hữu · Giao dịch CSDL + cập nhật có điều kiện (idempotent) · AuditService ghi nhật ký · NotificationsService · CampaignExpiryService (@Cron mỗi giờ)" style="fontFamily=Times New Roman;fontSize=13;rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="720" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Lớp truy cập dữ liệu (Repository)&lt;/b&gt;&lt;br&gt;TypeORM Repository&amp;lt;Entity&amp;gt; · truy vấn tham số hóa · migration có thứ tự và rollback (không dùng synchronize)" style="fontFamily=Times New Roman;fontSize=13;rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#666666;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="720" height="110" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;MySQL 8&lt;/b&gt;" style="fontFamily=Times New Roman;fontSize=13;shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="330" y="510" width="140" height="90" as="geometry"/></mxCell><mxCell id="c6" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c7" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Lớp tích hợp (integrations/)&lt;/b&gt;&lt;br&gt;&lt;br&gt;«interface» PaymentGateway → DemoWalletGateway&lt;br&gt;«interface» AiGateway → HttpAiGateway&lt;br&gt;«interface» EmailGateway → SmtpEmailGateway / LogEmailGateway&lt;br&gt;«interface» StorageGateway → LocalStorageGateway / S3StorageGateway&lt;br&gt;&lt;br&gt;Tiêm phụ thuộc qua token chuỗi → đổi nhà cung cấp không ảnh hưởng nghiệp vụ; luôn có bản giả lập / dự phòng." style="fontFamily=Times New Roman;fontSize=13;rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="820" y="210" width="300" height="230" as="geometry"/></mxCell><mxCell id="c10" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Mô-đun nghiệp vụ&lt;/b&gt;: auth · users · campaigns · donations · rewards · finance · progress · comments · follows · media · moderation · notifications · admin · ai · health" style="fontFamily=Times New Roman;fontSize=13;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="1080" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>