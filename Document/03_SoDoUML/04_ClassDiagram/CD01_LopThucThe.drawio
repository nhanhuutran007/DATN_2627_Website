nt="1"><mxGeometry x="2190" y="504" width="230" height="114" as="geometry"/></mxCell><mxCell id="c36" value="Ghi chú: mọi lớp kế thừa BaseEntity, trừ RevokedToken (khóa chính jti) và CampaignViewDaily (khóa chính ghép campaignId + viewDate). Để sơ đồ dễ đọc, quan hệ tới User của các lớp token, Notification, BehaviorEvent, MediaFile, CampaignFollow, CampaignComment, Report, RefundRequest, MilestoneRevision và người xử lý (reviewedBy, resolvedBy, hiddenBy) được thể hiện qua thuộc tính khóa ngoại; đủ 37 quan hệ xem Đặc tả ERD chương 3. AuditLog.userId và RiskAlert.entityId là tham chiếu logic, không có khóa ngoại. currentAmount và backerCount chỉ cập nhật từ giao dịch completed." style="fontFamily=Times New Roman;fontSize=13;shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#fffde7;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2190" y="652" width="270" height="230" as="geometry"/></mxCell><mxCell id="c37" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="308" y="143"/><mxPoint x="308" y="126.9"/></Array></mxGeometry></mxCell><mxCell id="c38" value="0..*" style="fontFamily=Times New Roman;fontSize=13;edgeLabel;html=1;resizable=0;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c37"><mxGeometry x="-0.7" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c39" value="1" style="fontFamily=Times New Roman;fontSize=13;edgeLabel;html=1;resizable=0;fontSize=12;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="c37"><mxGeometry x="0.7" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="c40" value="" style="fon