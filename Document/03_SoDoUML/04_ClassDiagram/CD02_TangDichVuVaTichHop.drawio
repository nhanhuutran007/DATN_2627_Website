278" y="347.75"/><mxPoint x="1278" y="688.5"/></Array></mxGeometry></mxCell><mxCell id="c54" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;dashed=1;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1284" y="1307"/><mxPoint x="1284" y="927"/></Array></mxGeometry></mxCell><mxCell id="c55" value="" style="fontFamily=Times New Roman;fontSize=13;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;dashed=1;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c21" target="c40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="176.25"/><mxPoint x="1290" y="1192.5"/></Array></mxGeometry></mxCell><mxCell id="c56" value='Ghi chú: hầu hết service còn phụ thuộc AuditService (ghi nhật ký kiểm toán), NotificationsService (thông báo) và truy cập CSDL qua Repository (TypeORM); các phụ thuộc này được lược bỏ để hình dễ đọc. Gateway được tiêm qua token chuỗi ("PaymentGateway", "AiGateway"…) nên có thể thay nhà cung cấp mà không đổi nghiệp vụ. SepayGateway chỉ được tạo khi cấu hình SEPAY_MERCHANT_ID; ở production ví demo tự tắt.' style="fontFamily=Times New Roman;fontSize=13;shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fillColor=#fffde7;strokeColor=#b8a000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="1276" width="640" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>