// Góp Mầm — schema MySQL 8 (khớp migration tới 1790000000012).
// Dán vào https://dbdiagram.io để vẽ ERD vật lý, hoặc xuất PNG/PDF cho báo cáo.

Project gop_mam {
  database_type: 'MySQL'
  Note: 'Nền tảng gây quỹ cộng đồng Góp Mầm (DATN_2627)'
}

// ───────────── Kiểu liệt kê (ENUM) ─────────────

Enum users_role {
  user
  campaign_owner
  admin
}

Enum users_status {
  active
  inactive
  banned
}

Enum campaigns_status {
  draft
  pending
  approved
  rejected
  needs_info
  active
  paused
  success
  failed
  cancelled
  ended
}

Enum media_files_purpose {
  campaign_image
  progress_image
  avatar
  expense_receipt
  refund_proof
  organization_logo
  organization_document
}

Enum donations_status {
  pending
  completed
  failed
  refunded
  expired
  cancelled
}

Enum refund_requests_status {
  pending
  approved
  rejected
}

Enum campaign_comments_kind {
  comment
  question
}

Enum campaign_comments_status {
  visible
  hidden
}

Enum reports_reason {
  spam
  fraud
  inappropriate
  misinformation
  other
}

Enum reports_status {
  pending
  reviewing
  resolved
  dismissed
}

Enum risk_alerts_entity_type {
  campaign
  user
}

Enum risk_alerts_risk_level {
  low
  medium
  high
}

Enum risk_alerts_method {
  ai
  rule
}

Enum risk_alerts_status {
  open
  resolved
  dismissed
}

Enum behavior_events_event_type {
  view
  follow
  contribute
  search
}

Enum organizations_org_type {
  charity_fund
  ngo
  social_enterprise
  education
  health
  other
}

Enum organizations_status {
  pending
  needs_info
  verified
  rejected
  suspended
}

Enum notifications_type {
  campaign_approved
  campaign_rejected
  campaign_needs_info
  campaign_paused
  campaign_resumed
  campaign_ended
  donation_received
  donation_confirmed
  milestone_completed
  progress_update
  report_resolved
  comment_new
  comment_reply
  comment_hidden
  refund_approved
  refund_rejected
  donation_refunded
  milestone_overdue
  milestone_rescheduled
  system
}
// ───────────── Tài khoản ─────────────

Table users {
  id char(36) [pk]
  name varchar(100) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null, note: 'tài khoản tạo bằng Google nhận hash của mật khẩu ngẫu nhiên']
  google_id varchar(64) [unique, note: 'sub của Google; NULL nếu chưa liên kết']
  role users_role [not null, default: 'user']
  status users_status [not null, default: 'active']
  avatar varchar(255)
  bio varchar(500)
  phone varchar(100)
  organization varchar(255) [note: 'đơn vị công tác ghi tự do, khác bảng organizations']
  email_verified tinyint(1) [not null, default: 0]
  failed_login_count int [not null, default: 0]
  locked_until datetime
  password_changed_at datetime
  sessions_revoked_at datetime
  ai_tracking_consent tinyint(1) [not null, default: 0]
  ai_consent_updated_at datetime
  created_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
  updated_at datetime(6) [not null, default: `CURRENT_TIMESTAMP(6)`]
}

Table email_verification_tokens {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  token_hash char(64) [not null, unique, note: 'SHA-256 của token gửi qua email']
  expires_at datetime [not null]
  used_at datetime
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (user_id, created_at)
  }
}

Table password_reset_tokens {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  token_hash char(64) [not null, unique]
  expires_at datetime [not null]
  used_at datetime
  requested_ip varchar(45)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (user_id, created_at)
  }
}

Table step_up_codes {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id, note: 'ON DELETE CASCADE']
  purpose varchar(30) [not null, note: 'change_password / refund_request / admin_refund / admin_backup']
  code_hash char(64) [not null, note: 'HMAC-SHA256 của mã OTP 6 số (khóa bí mật phía server)']
  expires_at datetime [not null, note: 'hết hạn sau 10 phút']
  attempts int [not null, default: 0, note: 'tối đa 5 lần nhập sai']
  used_at datetime
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (user_id, purpose, created_at)
  }
}

Table revoked_tokens {
  jti char(36) [pk, note: 'jti của JWT đã đăng xuất']
  user_id char(36) [not null, ref: > users.id]
  expires_at datetime [not null]
  created_at datetime(6) [not null]
  indexes {
    expires_at
  }
}

// ───────────── Chiến dịch & tiến độ ─────────────

Table campaigns {
  id char(36) [pk]
  title varchar(200) [not null]
  description mediumtext [not null, note: 'HTML đã làm sạch ở server']
  category varchar(100) [not null, note: 'tên danh mục (categories.name), không có FK']
  owner_id char(36) [not null, ref: > users.id]
  organization_id char(36) [ref: > organizations.id, note: 'tổ chức thụ hưởng; NULL = gây quỹ cho dự án của chủ chiến dịch']
  goal_amount decimal(15,2) [not null]
  current_amount decimal(15,2) [not null, default: 0]
  start_date datetime [not null]
  end_date datetime [not null]
  status campaigns_status [not null, default: 'draft']
  submitted_at datetime [note: 'lần gửi duyệt gần nhất, sắp xếp hàng chờ']
  is_featured tinyint(1) [not null, default: 0, note: 'admin chọn nổi bật trên trang chủ']
  featured_at datetime
  image_url varchar(500)
  video_url varchar(500)
  location varchar(255)
  backer_count int [not null, default: 0]
  view_count int [not null, default: 0]
  rejection_reason text
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    status
    category
    (is_featured, featured_at)
    organization_id
  }
}

Table organizations {
  id char(36) [pk]
  slug varchar(140) [not null, unique]
  name varchar(200) [not null]
  org_type organizations_org_type [not null]
  registration_number varchar(100) [not null, note: 'không trùng giữa các hồ sơ chưa bị từ chối (kiểm ở tầng dịch vụ)']
  issued_by varchar(200) [not null]
  category varchar(100) [note: 'lĩnh vực hoạt động ghi tự do, không có FK']
  mission text [not null]
  website varchar(300)
  email varchar(200) [not null]
  phone varchar(30) [not null]
  address varchar(300) [not null]
  province varchar(100) [not null]
  logo_url varchar(500)
  document_url varchar(500) [not null, note: 'ảnh giấy phép, không trả ở API công khai']
  representative_id char(36) [not null, ref: > users.id]
  representative_title varchar(100) [not null]
  status organizations_status [not null, default: 'pending']
  review_notes text
  reviewed_by char(36) [ref: > users.id]
  reviewed_at datetime
  verified_at datetime
  submitted_at datetime [not null]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  deleted_at datetime(6) [note: 'xóa mềm']
  indexes {
    (status, submitted_at)
    registration_number
  }
}

Table categories {
  id char(36) [pk]
  name varchar(100) [not null, unique]
  description varchar(300)
  sort_order int [not null, default: 0]
  is_active tinyint(1) [not null, default: 1, note: '0 = không nhận chiến dịch mới']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
}

Table campaign_view_daily {
  campaign_id char(36) [not null, ref: > campaigns.id, note: 'ON DELETE CASCADE']
  view_date date [not null, note: 'ngày UTC']
  views int [not null, default: 0]
  indexes {
    (campaign_id, view_date) [pk]
  }
}

Table milestones {
  id char(36) [pk]
  campaign_id char(36) [not null, ref: > campaigns.id]
  title varchar(200) [not null]
  description text
  target_date datetime
  budget decimal(15,2)
  sort_order int [not null, default: 0]
  is_completed tinyint(1) [not null, default: 0]
  completed_at datetime
  overdue_notified_at datetime [note: 'lần cuối nhắc mốc quá hạn']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
}

Table milestone_updates {
  id char(36) [pk]
  milestone_id char(36) [not null, ref: > milestones.id]
  content text [not null]
  image_url varchar(500)
  expense_amount decimal(15,2)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
}

Table milestone_update_attachments {
  id char(36) [pk]
  milestone_update_id char(36) [not null, ref: > milestone_updates.id, note: 'ON DELETE CASCADE']
  media_file_id char(36) [not null, unique, ref: - media_files.id, note: 'mỗi chứng từ chỉ gắn một lần']
  url varchar(500) [not null]
  caption varchar(200)
  sort_order int [not null, default: 0]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (milestone_update_id, sort_order)
  }
}

Table milestone_revisions {
  id char(36) [pk]
  milestone_id char(36) [not null, ref: > milestones.id, note: 'ON DELETE CASCADE']
  changed_by char(36) [not null, ref: > users.id]
  reason varchar(500) [not null]
  old_values text [not null, note: 'JSON giá trị cũ']
  new_values text [not null, note: 'JSON giá trị mới']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (milestone_id, created_at)
  }
}

Table reward_tiers {
  id char(36) [pk]
  campaign_id char(36) [not null, ref: > campaigns.id]
  title varchar(120) [not null]
  description text [not null]
  min_amount decimal(15,2) [not null, note: 'CHECK > 0']
  quantity_limit int [note: 'NULL = không giới hạn']
  claimed_count int [not null, default: 0, note: 'CHECK claimed_count <= quantity_limit']
  estimated_delivery date
  sort_order int [not null, default: 0]
  is_active tinyint(1) [not null, default: 1]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  deleted_at datetime(6) [note: 'xóa mềm']
  indexes {
    (campaign_id, sort_order)
  }
}

Table media_files {
  id char(36) [pk]
  owner_id char(36) [not null, ref: > users.id]
  storage_key varchar(120) [not null, unique]
  mime_type varchar(50) [not null]
  size_bytes int [not null]
  purpose media_files_purpose [not null]
  original_name varchar(255)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  deleted_at datetime(6) [note: 'xóa mềm']
  indexes {
    (owner_id, created_at)
  }
}

// ───────────── Giao dịch ─────────────

Table donations {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  campaign_id char(36) [not null, ref: > campaigns.id]
  reward_tier_id char(36) [ref: > reward_tiers.id]
  amount decimal(15,2) [not null]
  currency varchar(3) [not null, default: 'VND']
  status donations_status [not null, default: 'pending']
  payment_method varchar(50)
  transaction_id varchar(255) [unique]
  transfer_code varchar(20) [unique, note: 'nội dung chuyển khoản VietQR/SePay, vd. GM7K2QX9AB']
  idempotency_key varchar(255) [not null, unique]
  message text
  is_anonymous tinyint(1) [not null, default: 0]
  completed_at datetime
  refunded_at datetime
  refund_reference varchar(255)
  refund_reason varchar(500)
  refund_method varchar(20) [note: 'gateway / manual_transfer']
  refund_proof_url varchar(500) [note: 'ảnh chứng từ chuyển khoản hoàn (manual_transfer)']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    user_id
    campaign_id
    (status, created_at)
  }
}

Table refund_requests {
  id char(36) [pk]
  donation_id char(36) [not null, ref: > donations.id]
  user_id char(36) [not null, ref: > users.id]
  reason text [not null]
  bank_name varchar(100) [note: 'tài khoản nhận hoàn khi phải chuyển khoản thủ công']
  bank_account_number varchar(30)
  bank_account_name varchar(100)
  status refund_requests_status [not null, default: 'pending']
  admin_notes text
  reviewed_by char(36) [ref: > users.id]
  reviewed_at datetime
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (status, created_at)
    (donation_id, status)
  }
}

// ───────────── Cộng đồng ─────────────

Table campaign_comments {
  id char(36) [pk]
  campaign_id char(36) [not null, ref: > campaigns.id]
  user_id char(36) [not null, ref: > users.id]
  parent_id char(36) [ref: > campaign_comments.id, note: 'trả lời 1 cấp']
  kind campaign_comments_kind [not null, default: 'comment']
  content text [not null]
  status campaign_comments_status [not null, default: 'visible']
  hidden_reason varchar(500)
  hidden_by char(36) [ref: > users.id]
  hidden_at datetime
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  deleted_at datetime(6) [note: 'xóa mềm']
  indexes {
    (campaign_id, parent_id, created_at)
    (status, created_at)
  }
}

Table campaign_follows {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  campaign_id char(36) [not null, ref: > campaigns.id]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (user_id, campaign_id) [unique]
    campaign_id
  }
}

// ───────────── Kiểm duyệt & rủi ro ─────────────

Table reports {
  id char(36) [pk]
  reporter_id char(36) [not null, ref: > users.id]
  campaign_id char(36) [ref: > campaigns.id]
  comment_id char(36) [ref: > campaign_comments.id]
  reason reports_reason [not null]
  description text [not null]
  status reports_status [not null, default: 'pending']
  admin_notes text
  resolved_by char(36) [ref: > users.id]
  resolved_at datetime
  campaign_paused tinyint(1) [not null, default: 0]
  comment_hidden tinyint(1) [not null, default: 0]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (status, created_at)
    (campaign_id, reporter_id)
  }
}

Table risk_alerts {
  id char(36) [pk]
  entity_type risk_alerts_entity_type [not null]
  entity_id char(36) [not null, note: 'đa hình: campaigns.id hoặc users.id, không có FK']
  entity_name varchar(255) [not null]
  risk_level risk_alerts_risk_level [not null, default: 'medium']
  risk_score float [not null, default: 0]
  method risk_alerts_method [not null, default: 'ai']
  reasons json [not null]
  evidences json [not null]
  status risk_alerts_status [not null, default: 'open']
  resolved_by char(36) [ref: > users.id]
  resolved_at datetime(6)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    status
    (entity_type, entity_id)
  }
}

// ───────────── AI ─────────────

Table behavior_events {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  campaign_id char(36) [not null, ref: > campaigns.id]
  event_type behavior_events_event_type [not null]
  category varchar(100) [not null]
  event_data json
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (user_id, event_type)
    campaign_id
  }
}

// ───────────── Hệ thống ─────────────

Table notifications {
  id char(36) [pk]
  user_id char(36) [not null, ref: > users.id]
  type notifications_type [not null]
  title varchar(200) [not null]
  message text [not null]
  link varchar(300)
  is_read tinyint(1) [not null, default: 0]
  related_id char(36) [note: 'id đối tượng liên quan, không có FK']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (user_id, is_read, created_at)
  }
}

Table audit_logs {
  id char(36) [pk]
  user_id varchar(36) [note: 'không có FK — giữ log khi user bị xóa']
  action varchar(100) [not null]
  entity varchar(100) [not null]
  entity_id varchar(36)
  old_values json
  new_values json
  ip_address varchar(45)
  user_agent varchar(500)
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
}

TableGroup tai_khoan {
  users
  email_verification_tokens
  password_reset_tokens
  revoked_tokens
  step_up_codes
}
TableGroup chien_dich {
  campaigns
  organizations
  categories
  campaign_view_daily
  milestones
  milestone_updates
  milestone_update_attachments
  milestone_revisions
  reward_tiers
  media_files
}
TableGroup giao_dich {
  donations
  refund_requests
}
TableGroup cong_dong {
  campaign_comments
  campaign_follows
}
TableGroup kiem_duyet {
  reports
  risk_alerts
}
TableGroup he_thong {
  behavior_events
  notifications
  audit_logs
}
