# Backend Environment Variables
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Số hop reverse-proxy đáng tin (Express "trust proxy") để req.ip đọc đúng IP
# thật của client qua Nginx/ALB. 1 = tin đúng 1 hop trước backend.
TRUST_PROXY_HOPS=1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=crowdfunding

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=
AI_TIMEOUT_MS=3000

# Payment (sandbox): secret dùng để ký/verify webhook HMAC-SHA256 (header X-Signature).
# Để trống = từ chối mọi webhook. Không commit giá trị thật.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-value
