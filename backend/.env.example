# Backend Environment Variables
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Số hop reverse-proxy đáng tin (Express "trust proxy") để req.ip đọc đúng IP
# thật của client qua Nginx/ALB. 1 = tin đúng 1 hop trước backend.
TRUST_PROXY_HOPS=1

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=crowdfunding
# TLS tới MySQL (bắt buộc với RDS MySQL 8.4); để trống khi chạy local
DB_SSL=
DB_SSL_CA_PATH=

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Đăng nhập bằng Google: OAuth Client ID (loại "Web application") tạo ở Google Cloud Console,
# thêm http://localhost:3000, http://localhost:8080 vào "Authorized JavaScript origins".
# Để trống thì trang đăng nhập ẩn nút Google. Chỉ cần Client ID, không cần Client secret.
GOOGLE_CLIENT_ID=

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=
AI_TIMEOUT_MS=3000

# Payment (sandbox): secret dùng để ký/verify webhook HMAC-SHA256 (header X-Signature).
# Để trống = từ chối mọi webhook. Không commit giá trị thật.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-value
# Phút chờ thanh toán trước khi đơn `pending` tự chuyển `expired` (mặc định 30)
DONATION_PENDING_TTL_MINUTES=30
# Cổng thanh toán SePay (QR chuyển khoản). Lấy merchant/secret ở my.sepay.vn → Cổng thanh toán.
# Để trống SEPAY_MERCHANT_ID hoặc SEPAY_SECRET_KEY = ẩn kênh SePay. Không commit giá trị thật.
# IPN URL khai báo trên SePay: https://<domain>/api/v1/payments/sepay/ipn (auth type = SECRET_KEY).
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Khóa SePay gửi trong header X-Secret-Key của IPN; để trống = dùng SEPAY_SECRET_KEY
SEPAY_IPN_SECRET=
# Gốc URL frontend, dùng tạo link trong email (đặt lại mật khẩu)
FRONTEND_URL=http://localhost:3000

# Gửi email (quên mật khẩu). Để trống SMTP_HOST thì link chỉ được ghi vào log backend.
# Gmail: bật Xác minh 2 bước, tạo App Password tại https://myaccount.google.com/apppasswords
# rồi dán 16 ký tự vào SMTP_PASS (có hay không có dấu cách đều được).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Ảnh tải lên (POST /media/images): "local" ghi ra UPLOAD_DIR (mặc định ./uploads),
# "s3" ghi lên bucket S3_BUCKET (AWS, quyền qua IAM task role).
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=ap-southeast-1
