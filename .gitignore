# Environment and secrets
.env
.env.*
!.env.example
!**/.env.example

# Node.js
node_modules/
.next/
dist/
.test-dist/
coverage/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/

# AI data and trained artifacts
ai-service/data/raw/*
ai-service/data/processed/*
ai-service/artifacts/*
ai-service/models/*.pkl
ai-service/models/*.joblib
!ai-service/data/raw/.gitkeep
!ai-service/data/processed/.gitkeep
!ai-service/artifacts/README.md
!ai-service/models/README.md
# Mô hình dùng khi chạy được commit để máy nào clone về cũng chấm bằng AI (không lùi về luật);
# mô hình thật tạo bằng ai-service/notebooks/train_real_data_colab.ipynb; IsolationForest dự phòng
# tạo bằng `python -m training.train`, cùng phiên bản thư viện ghim trong requirements.txt
!ai-service/models/fraud_isolation.pkl
!ai-service/models/fraud_scaler.pkl
!ai-service/models/success_model.pkl
!ai-service/models/fraud_classifier.pkl

# Terraform (state có thể chứa mật khẩu/secret; lock file .terraform.lock.hcl vẫn được commit)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
*.tfplan
crash.log
override.tf
override.tf.json

# Runtime files
.tools/
logs/
uploads/
tmp/
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Mã nguồn/dữ liệu của dự án cũ, không thuộc đồ án này
baocao/
nhlsports*.sql

