# Copy this file to .env for Docker Compose. Never commit real secrets.
APP_ENV=development
STAGING_HTTP_PORT=8080

MYSQL_PORT=3307
MYSQL_DATABASE=crowdfunding
MYSQL_USER=crowdfunding_app
MYSQL_PASSWORD=replace-for-local-use
MYSQL_ROOT_PASSWORD=replace-root-for-local-use

REDIS_PORT=6379

BACKEND_PORT=4000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-value

AI_SERVICE_PORT=8000
AI_MODEL_PATH=/app/models/success_model.pkl
AI_LOAD_MODEL=false

NEXT_PUBLIC_API_URL=/api/v1
